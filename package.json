    "test:triagens": "ng test --watch=false --ts-config tsconfig.triagens-spec.json --include=src/app/features/triagens/services/triagens-service.spec.ts"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@lucide/angular": "^1.31.0",
    "@primeng/themes": "^21.0.4",
    "chart.js": "^4.6.1",
    "jwt-decode": "^4.0.0",
    "pdfmake": "^0.3.11",
    "primeicons": "^8.0.0",
    "primeng": "^21.1.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@angular/language-service": "^21.2.19",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/pdfmake": "^0.3.3",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.0",
    "vitest": "^4.0.8"
  }
